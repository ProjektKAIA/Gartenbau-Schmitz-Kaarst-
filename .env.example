# Mailversand der Shop-Anfragen (Nodemailer über SMTP).
# Lokal nach .env.local kopieren und ausfüllen; auf Vercel im Projekt-Dashboard setzen. Nie committen.

# SMTP-Server des Mail-Anbieters
SMTP_HOST=
# 465 = implizites TLS (SMTP_SECURE=true), 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Absender aller Shop-Mails, z. B. "Gartenbau Kaarst <shop@gartenbau-kaarst.de>"
MAIL_FROM=
# Empfänger der Anfragen im Betrieb
MAIL_TO=info@gartenbau-kaarst.de
